{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/assets",
      "!**/pnpm-lock.yaml",
      "!**/LICENSE",
      "!packages/api-contract/src/generated.ts",
      "!packages/api-contract/fleetiq-v1-ui-baseline.openapi.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
