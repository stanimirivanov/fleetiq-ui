{
  "name": "fleetiq-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fleetiq/web dev",
    "build": "pnpm --filter @fleetiq/web build && node tools/quality/bundle.mjs",
    "typecheck": "pnpm --filter @fleetiq/web typecheck && pnpm exec tsc --noEmit -p apps/web-e2e/tsconfig.json",
    "style:check": "biome ci .",
    "architecture": "node tools/check-architecture.mjs",
    "view:check": "node --test tools/check-view-size.test.mjs && node tools/check-view-size.mjs",
    "docs:check": "node tools/check-docs.mjs",
    "design:check": "node tools/check-design-tokens.mjs",
    "contract:generate": "node tools/check-asset-contract.mjs && node tools/generate-asset-contract.mjs",
    "contract:check": "node tools/check-asset-contract.mjs && node tools/generate-asset-contract.mjs --check",
    "test:unit": "pnpm --filter @fleetiq/web test:unit",
    "test:component": "pnpm --filter @fleetiq/web test:component",
    "test": "pnpm test:unit && pnpm test:component",
    "e2e": "node tools/verification/cli.mjs --group browser",
    "e2e:production": "pnpm build && pnpm exec playwright test --config apps/web-e2e/playwright.config.ts",
    "e2e:development": "pnpm exec playwright test --config apps/web-e2e/playwright.development.config.ts",
    "guide:generate": "node tools/user-guide/generate.mjs",
    "guide:preview": "node tools/user-guide/preview.mjs",
    "check": "node tools/verification/cli.mjs --group acceptance",
    "guide:test": "node --test tools/user-guide/*.test.mjs",
    "verify": "node tools/verification/cli.mjs",
    "harness:check": "node tools/verification/check-policy.mjs",
    "harness:test": "node --test tools/docs/*.test.mjs tools/sensors/*.test.mjs tools/check-architecture.test.mjs tools/architecture/*.test.mjs tools/boundaries/*.test.mjs tools/security/*.test.mjs tools/verification/*.test.mjs tools/quality/*.test.mjs tools/images/tests/*.test.mjs",
    "boundaries:check": "node tools/check-boundaries.mjs",
    "security:install": "node tools/security/install.mjs",
    "security:secrets": "node tools/security/secrets.mjs",
    "security:dependencies": "node tools/security/advisories.mjs",
    "security:artifacts": "node tools/security/artifacts.mjs",
    "guide:release": "node tools/user-guide/release.mjs",
    "quality:mutations": "node tools/quality/mutations.mjs",
    "e2e:quality": "pnpm build && pnpm exec playwright test --config apps/web-e2e/playwright.quality.config.ts",
    "quality:configuration": "node tools/quality/configuration.mjs",
    "quality:page-errors": "node tools/quality/browser-error-fixture.mjs",
    "dependencies:review": "node tools/verification/upgrades-cli.mjs",
    "dependencies:qualify": "node tools/verification/cli.mjs --candidate",
    "image:tests": "node --test tools/images/tests/*.test.mjs",
    "image:policy": "node tools/images/check-policy.mjs",
    "image:artifact": "node tools/images/qualify.mjs",
    "image:qualify": "node tools/verification/cli.mjs --group image",
    "security:image": "node tools/verification/cli.mjs --group image-security",
    "security:preflight": "pnpm verify --group security && pnpm security:image",
    "image:security-artifact": "node tools/images/security.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@effect/openapi-generator": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "dependency-cruiser": "18.6.0",
    "github-slugger": "2.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "typescript-parser": "npm:typescript@6.0.3",
    "unified": "11.0.5",
    "vite": "8.3.4",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  }
}
