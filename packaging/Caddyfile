{
  admin off
  persist_config off
  auto_https off
}
http://:8081 {
  bind 127.0.0.1
  respond /ready 200
}
http://:8080 {
  route {
  @wrongHost not host {$FLEETIQ_PUBLIC_AUTHORITY}
  respond @wrongHost 421
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    import /usr/share/fleetiq/csp.caddy
    -Server
  }
  @backend path /api /api/* /health/*
  handle @backend {
    header {
      >Cache-Control no-store
      -ETag
    }
    reverse_proxy {$FLEETIQ_API_UPSTREAM} {
      header_up -Forwarded
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {$FLEETIQ_PUBLIC_AUTHORITY}
      transport http {
        dial_timeout 2s
        response_header_timeout 5s
      }
    }
  }
  @internal path /.env* /.git* /quality-manifest.json /*.map
  respond @internal 404
  handle /assets/* {
    root * /srv
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    @notRead not method GET HEAD
    header @notRead Allow "GET, HEAD"
    respond @notRead 405
    root * /srv
    header Cache-Control no-cache
    try_files {path} /index.html
    file_server
  }
}
  handle_errors {
    header {
      Cache-Control no-store
      X-Content-Type-Options nosniff
      -Server
    }
    respond "{err.status_text}" {err.status_code}
  }
}
