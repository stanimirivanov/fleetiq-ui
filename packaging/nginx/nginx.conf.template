# Private HTTP edge. TLS and client identity belong to the gateway and backend.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 512; }
http {
  include /etc/nginx/mime.types;
  types { application/javascript mjs; }
  default_type application/octet-stream;
  access_log off;
  server_tokens off;
  client_body_temp_path /tmp/client-body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  client_max_body_size 8m;
  client_header_timeout 10s;
  client_body_timeout 15s;
  send_timeout 15s;
  keepalive_timeout 15s;
  proxy_connect_timeout 2s;
  proxy_read_timeout 5s;
  proxy_send_timeout 15s;
  add_header_inherit merge;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header X-Frame-Options DENY always;
  include /usr/share/fleetiq/csp.conf;
  # Host matching excludes its optional port, as in the predecessor edge. The
  # canonical complete authority is forwarded from validated configuration only.
  map $host $fleet_host_allowed { default 0; "@@PUBLIC_HOST@@" 1; }
  server {
    listen 127.0.0.1:8081;
    location = /ready { return 200; }
    location / { return 404; }
  }
  server {
    listen 8080 default_server;
    server_name _;
    root /srv;
    if ($http_host = "") { return 421; }
    if ($fleet_host_allowed = 0) { return 421; }
    location = /api { include @@SCRATCH@@/proxy.conf; }
    location ^~ /api/ {
      include @@SCRATCH@@/proxy.conf;
      # Ordinary API responses retain 5s; SSE has a separate bounded idle window.
      location ~ ^/api/v1/tenants/[^/]+/assets/[^/]+/properties/[^/]+/versions/[0-9]+/live$ {
        include @@SCRATCH@@/proxy.conf;
        proxy_read_timeout 75s;
      }
    }
    location ^~ /health/ { include @@SCRATCH@@/proxy.conf; }
    location ~ (^/\.(env|git)|\.map$|^/quality-manifest\.json$) {
      add_header Cache-Control no-store always;
      return 404;
    }
    location /maps/ {
      if ($request_method !~ ^(GET|HEAD)$) { add_header Allow "GET, HEAD" always; return 405; }
      add_header Cache-Control no-cache always;
      try_files $uri =404;
    }
    # Only compiled resource filenames are static; /assets/<id> is a SPA route.
    location ~ ^/assets/.*\.(js|mjs|css|woff|woff2|png|jpg|jpeg|gif|svg|ico)$ {
      if ($request_method !~ ^(GET|HEAD)$) { add_header Allow "GET, HEAD" always; return 405; }
      add_header Cache-Control "public, max-age=31536000, immutable";
      try_files $uri =404;
    }
    location / {
      if ($request_method !~ ^(GET|HEAD)$) { add_header Allow "GET, HEAD" always; return 405; }
      add_header Cache-Control no-cache always;
      try_files $uri /index.html;
    }
  }
}
